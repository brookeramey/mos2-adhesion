&INPUTPP
  prefix        = 'mos2_chden'
  outdir        = './tmp/chden_centered/'
  filplot       = 'outputs/mos2_chden_centered.dat'
  plot_num      = 0
/

&PLOT
  nfile         = 1
  filepp(1)     = 'outputs/mos2_chden_centered.dat'
  weight(1)     = 1.0
  iflag         = 3
  output_format = 6
  fileout       = 'outputs/mos2_chden_centered.cube'
  nx=40, ny=40, nz=480
/
