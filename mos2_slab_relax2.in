&CONTROL
  calculation   = 'relax'
  prefix        = 'mos2_slab2'
  outdir        = './tmp/relax2/'
  pseudo_dir    = './pseudo/'
  verbosity     = 'low'
  tprnfor       = .true.
  tstress       = .false.
  forc_conv_thr = 1.0e-4
/

&SYSTEM
  ibrav=4
  a=3.160
  c=30.0
  nat=12
  ntyp=2
  ecutwfc=80.0
  ecutrho=640.0
  occupations='smearing'
  smearing='m-p'
  degauss=0.02
  input_dft='vdw-df2-b86r'
/

&ELECTRONS
  mixing_mode   = 'local-TF'
  mixing_beta   = 0.2
  conv_thr      = 1.0e-8
/

&IONS
  ion_dynamics  = 'bfgs'
  upscale       = 10
  bfgs_ndim     = 8
  trust_radius_max = 0.3
  trust_radius_ini = 0.1
/

ATOMIC_SPECIES
  Mo  95.960  Mo.pbe-spn-kjpaw_psl.1.0.0.UPF
  S   32.060  S.pbe-n-kjpaw_psl.1.0.0.UPF

